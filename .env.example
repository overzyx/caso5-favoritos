PERFIL_A_EMAIL=
PERFIL_A_CLAVE=
PERFIL_B_EMAIL=
PERFIL_B_CLAVE=

# Los escenarios comparten las mismas cuentas: se ejecutan en serie
WORKERS=1
# false para ver el navegador mientras corre
HEADLESS=true
